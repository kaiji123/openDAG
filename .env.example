# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron model IDs. Check the exact IDs for your account with:
#   python -m scripts.check_setup
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_REASON=nvidia/nemotron-3-super-120b-a12b

# --- Tavily (evidence search) ---
TAVILY_API_KEY=

# --- Limits (protect your token budget) ---
# paper text sent to the extraction model (~6k tokens)
MAX_INPUT_CHARS=24000
MAX_TOKENS_EXTRACT=6000
MAX_TOKENS_CRITIQUE=3000
# new papers per IP per hour
RATE_LIMIT_PER_HOUR=5
# new papers across all users per day
DAILY_CAP=50
# "Ask the dataset" questions per IP per hour
ASK_PER_HOUR=20
# questions across all users per day
ASK_DAILY_CAP=400
# optional: bypasses rate limits via X-Admin-Token header
ADMIN_TOKEN=

# --- Spending cap (hard stop for every Nemotron and Tavily call; see app/budget.py) ---
# paid AI features pause before total spend passes this
BUDGET_USD=100
# spend from before the ledger existed (counted towards the budget)
SPENT_BEFORE_LEDGER_USD=1
# Durable ledger so restarts can't reset the total (needed on Render's free plan). Free at upstash.com.
# Put the same two values in your local .env too, so local scripts count towards the same total.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# set 1 on the public server: paid features stay off until the ledger is set
REQUIRE_DURABLE_BUDGET=0

# --- Storage ---
DB_PATH=opendag.db

# --- Alerts by e-mail (app/monitor.py) ---
# Resend API key (resend.com, free); without it alerts are only logged.
RESEND_API_KEY=
# where alerts go; with Resend's test sender this must be your Resend account's e-mail
ALERT_EMAIL=
