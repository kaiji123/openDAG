# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron model IDs. Check the exact IDs for your account with:
#   python -m scripts.check_setup
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_REASON=nvidia/nemotron-3-super-120b-a12b

# --- Tavily (evidence search) ---
TAVILY_API_KEY=

# --- Limits (protect your token budget) ---
MAX_INPUT_CHARS=24000         # paper text sent to the extraction model (~6k tokens)
MAX_TOKENS_EXTRACT=3000
MAX_TOKENS_CRITIQUE=3000
RATE_LIMIT_PER_HOUR=5         # new papers per IP per hour
DAILY_CAP=50                  # new papers across all users per day
ASK_PER_HOUR=20               # "Ask the dataset" questions per IP per hour
ASK_DAILY_CAP=400             # questions across all users per day
ADMIN_TOKEN=                  # optional: bypasses rate limits via X-Admin-Token header

# --- Storage ---
DB_PATH=opendag.db
